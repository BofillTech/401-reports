{
  "name": "401 Homebuilders — \"Call Me\" Test (Retell)",
  "nodes": [
    {
      "id": "wh",
      "name": "Call Request (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "401-callme-test",
      "parameters": {
        "httpMethod": "POST",
        "path": "401-callme-test",
        "responseMode": "responseNode",
        "options": { "allowedOrigins": "*" }
      }
    },
    {
      "id": "cfg",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [420, 300],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            { "id": "c1", "name": "RETELL_FROM_NUMBER", "value": "+14013861470", "type": "string" },
            { "id": "c2", "name": "RETELL_AGENT_ID", "value": "agent_REPLACE_ME", "type": "string" },
            { "id": "c3", "name": "TEST_PASSCODE", "value": "401demo", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "val",
      "name": "Validate & Build",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\n// Read the request, check the passcode, normalize the phone to E.164 (US),\n// and pass clean values to the Retell call. No valid passcode / phone => rejected.\nconst cfg = $json;                 // Config keys are merged in (includeOtherFields)\nconst b = ($json.body) || {};      // the POSTed JSON\nconst passOk = String(b.passcode || '').trim() === String(cfg.TEST_PASSCODE || '');\nlet digits = String(b.phone || '').replace(/\\D/g, '');\nif (digits.length === 10) digits = '1' + digits;\nconst e164 = (digits.length === 11 && digits[0] === '1') ? ('+' + digits) : null;\nconst ok = passOk && !!e164;\nconst reason = !passOk ? 'Wrong passcode.' : (!e164 ? 'Enter a valid 10-digit US phone number.' : 'ok');\nreturn [{ json: {\n  ok: ok,\n  reason: reason,\n  to_number: e164,\n  first_name: (String(b.name || '').trim() || 'there'),\n  inquiry: (String(b.inquiry || '').trim() || 'selling a property'),\n  RETELL_FROM_NUMBER: cfg.RETELL_FROM_NUMBER,\n  RETELL_AGENT_ID: cfg.RETELL_AGENT_ID\n} }];\n"
      }
    },
    {
      "id": "route",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [860, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "combinator": "and",
          "conditions": [
            { "id": "r1", "leftValue": "={{ $json.ok }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "retell",
      "name": "Retell — Call Now",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 200],
      "parameters": {
        "method": "POST",
        "url": "https://api.retellai.com/v2/create-phone-call",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Content-Type", "value": "application/json" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from_number: $json.RETELL_FROM_NUMBER, to_number: $json.to_number, override_agent_id: $json.RETELL_AGENT_ID, retell_llm_dynamic_variables: { first_name: $json.first_name, full_name: $json.first_name, inquiry: $json.inquiry, form_name: 'Self-test (Call me now)' }, metadata: { source: 'call-me-test' } }) }}",
        "options": {}
      },
      "credentials": { "httpHeaderAuth": { "id": "REPLACE_ME", "name": "Retell API Key" } }
    },
    {
      "id": "ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1300, 200],
      "parameters": {
        "respondWith": "json",
        "responseCode": 200,
        "responseHeaders": { "entries": [ { "name": "Access-Control-Allow-Origin", "value": "*" } ] },
        "responseBody": "={{ JSON.stringify({ ok: true, message: 'Calling you now — pick up in a few seconds!' }) }}"
      }
    },
    {
      "id": "rej",
      "name": "Respond Rejected",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1080, 440],
      "parameters": {
        "respondWith": "json",
        "responseCode": 200,
        "responseHeaders": { "entries": [ { "name": "Access-Control-Allow-Origin", "value": "*" } ] },
        "responseBody": "={{ JSON.stringify({ ok: false, error: $json.reason }) }}"
      }
    }
  ],
  "connections": {
    "Call Request (Webhook)": { "main": [[{ "node": "Config", "type": "main", "index": 0 }]] },
    "Config": { "main": [[{ "node": "Validate & Build", "type": "main", "index": 0 }]] },
    "Validate & Build": { "main": [[{ "node": "Valid?", "type": "main", "index": 0 }]] },
    "Valid?": { "main": [
      [{ "node": "Retell — Call Now", "type": "main", "index": 0 }],
      [{ "node": "Respond Rejected", "type": "main", "index": 0 }]
    ] },
    "Retell — Call Now": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templateId": "401-callme-test" },
  "tags": [ { "name": "401-homebuilders" }, { "name": "ws2" } ]
}
